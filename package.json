{
  "name": "livestream-copilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "kill:ports": "powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; $ports=3125,3126,3000,1935,8888,8889,9997; foreach($p in $ports){ Get-NetTCPConnection -LocalPort $p -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } }; exit 0\"",
    "dev": "concurrently --names \"API,WEB\" -c \"cyan,magenta\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter desktop-companion dev",
    "dev:web": "pnpm --filter @livestream-copilot/web dev",
    "dev:api-only": "pnpm --filter desktop-companion dev",
    "dev:web-only": "pnpm --filter @livestream-copilot/web dev",
    "install:all": "pnpm install && pnpm db:generate",
    "db:generate": "pnpm --filter desktop-companion db:generate",
    "db:migrate": "pnpm --filter desktop-companion db:migrate",
    "db:studio": "pnpm --filter desktop-companion db:studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit -p apps/desktop-companion/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint apps/web/src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
